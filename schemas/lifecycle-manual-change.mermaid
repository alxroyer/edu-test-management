flowchart LR

style ReqMgt color: #FF9933, stroke: #FF9933, stroke-width: 2px, fill: #FFF5EB
Change --> Requirements
subgraph ReqMgt["Requirement Management"]
    Requirements
end

style Development color: #004C99, stroke: #004C99, stroke-width: 2px, fill: #DAE8FC
Requirements --> ImpactDev
subgraph Development
    ImpactDev["Impact analysis"]
    -..-> Deliver
end

style Test color: #336600, stroke: #336600, stroke-width: 2px, fill: #D5E8D4
Requirements --> ImpactTest
Deliver --> Execute
subgraph Test
    ImpactTest["Impact analysis"]
    --> Replan
    --> Rewrite
    --> Execute
    --> Report
end
Execute --> Bug

style IssueMgt color: #FF0000, stroke: #FF0000, stroke-width: 2px, fill: #FFF0F0
subgraph IssueMgt["Issue Management"]
    Change
    Bug
end
